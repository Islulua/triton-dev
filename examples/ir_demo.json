      "id": "ttir",
      "label": "TTIR",
      "content": "module {\n  tt.func public @vector_add(%X: !tt.ptr<f32>, %Y: !tt.ptr<f32>,\n      %Z: !tt.ptr<f32>) {\n    %pid = tt.get_program_id x : i32\n    %range = tt.make_range {start = 0, end = 256}\n    %base = arith.muli %pid, %c256 : i32\n    %offsets = arith.addi %base, %range\n    %mask = arith.cmpi slt, %offsets, %N\n    %xp = tt.addptr %X, %offsets\n    %x = tt.load %xp, %mask, %zero\n    %yp = tt.addptr %Y, %offsets\n    %y = tt.load %yp, %mask, %zero\n    %z = arith.addf %x, %y : tensor<256xf32>\n    %zp = tt.addptr %Z, %offsets\n    tt.store %zp, %z, %mask\n    tt.return\n  }\n}",
