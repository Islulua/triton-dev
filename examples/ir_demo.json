      "label": "CoreIR",
      "content": "module {\n  func.func @vector_add(%X: memref<?xf32>,\n      %Y: memref<?xf32>, %Z: memref<?xf32>) {\n    %pid = core.program_id 0 : index\n    %base = arith.muli %pid, %c256 : index\n    scf.for %i = %c0 to %c256 step %c1 {\n      %idx = arith.addi %base, %i : index\n      %mask = arith.cmpi slt, %idx, %N\n      scf.if %mask {\n        %x = memref.load %X[%idx] : memref<?xf32>\n        %y = memref.load %Y[%idx] : memref<?xf32>\n        %z = arith.addf %x, %y : f32\n        memref.store %z, %Z[%idx] : memref<?xf32>\n      }\n    }\n    return\n  }\n}",
